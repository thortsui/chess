}

/* ---------- drawing ---------- */
const X=c=>(50+100*c)/9, Y=r=>(50+100*r)/10;
function drawGrid(){
  let s='',L=(x1,y1,x2,y2,w=3)=>s+=`<line x1="${x1}" y1="${y1}" x2="${x2}" y2="${y2}" stroke="var(--line)" stroke-width="${w}" stroke-linecap="square"/>`;
  s+=`<rect x="38" y="38" width="824" height="924" fill="none" stroke="var(--line)" stroke-width="6"/>`;
  for(let r=0;r<10;r++)L(50,50+100*r,850,50+100*r);
  for(let c=0;c<9;c++){const x=50+100*c;if(c===0||c===8)L(x,50,x,950);else{L(x,50,x,450);L(x,550,x,950);}}
  L(350,50,550,250);L(550,50,350,250);L(350,750,550,950);L(550,750,350,950);
  const tick=(r,c)=>{const x=50+100*c,y=50+100*r,d=10,l=22;
    for(const sx of[-1,1]){if((sx<0&&c===0)||(sx>0&&c===8))continue;
      for(const sy of[-1,1]){const px=x+sx*d,py=y+sy*d;L(px,py,px+sx*l,py,2.5);L(px,py,px,py+sy*l,2.5);}}};
  [[2,1],[2,7],[7,1],[7,7]].forEach(([r,c])=>tick(r,c));
  [0,2,4,6,8].forEach(c=>{tick(3,c);tick(6,c);});
  const txt='font-family="Noto Serif TC,serif" font-weight="700" font-size="58" fill="var(--line)" opacity=".75" text-anchor="middle" dominant-baseline="central" letter-spacing="30"';
  s+=`<text x="250" y="500" ${txt}${mode==='local'?' transform="rotate(180 250 500)"':''}>楚河</text>`;
  s+=`<text x="650" y="500" ${txt}>漢界</text>`;
  $('grid').innerHTML=s;
}

function render(){
  if(mode==='menu')return;
  const local=mode==='local',flip=!local&&mySide==='b';
  const P=(r,c)=>`left:${X(flip?8-c:c)}%;top:${Y(flip?9-r:r)}%`;
