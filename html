}
function hideBanner(){clearTimeout(jiangTimer);const el=$('jiang');el.hidden=true;el.innerHTML='';}

function canAct(){
  if(over)return false;
  if(mode==='ai')return turn===mySide&&!thinking;
  if(mode!=='online')return true;
  if(turn!==mySide||pendingMove)return false;
  return role==='host'?!!(guestPeer&&guestOnline):hostOnline;
}
function tap(r,c){
  if(!canAct())return;
  if(sel&&targets.some(([rr,cc])=>rr===r&&cc===c)){
    const [fr,fc]=sel;
    if(mode==='online'&&role==='guest'){
      room.emit('mv',{fr,fc,tr:r,tc:c,seq}).catch(()=>{});
