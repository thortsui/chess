  if(!over&&(local||turn===mySide)){for(let r=0;r<10;r++)for(let c=0;c<9;c++){const p=board[r][c];
    if(p&&p.s===turn)legal(board,r,c).forEach(([rr,cc])=>{const q=board[rr][cc];if(q&&q.s!==turn)danger.add(rr*9+cc);});}}
  for(let r=0;r<10;r++)for(let c=0;c<9;c++){
    const p=board[r][c],isT=targets.some(([rr,cc])=>rr===r&&cc===c);
    if(p){const cls=['pc',p.s];if(local&&p.s==='b')cls.push('rot');
      if(sel&&sel[0]===r&&sel[1]===c)cls.push('sel');if(isT)cls.push('cap');
      if(chk&&chk[0]===r&&chk[1]===c)cls.push('incheck');
      const dg=danger.has(r*9+c);
      h+=`<button class="${cls.join(' ')}" data-r="${r}" data-c="${c}" style="${P(r,c)}" aria-label="${SIDE[p.s]}${NAMES[p.s][p.t]}${dg?'（可吃）':''}">${dg?'<span class="glow"></span>':''}<span class="face">${NAMES[p.s][p.t]}</span></button>`;}
    else if(isT)h+=`<button class="tg" data-r="${r}" data-c="${c}" style="${P(r,c)}" aria-label="移到這裡"></button>`;
  }
  $('layer').innerHTML=h;
  renderBars(chk);
}

function btn(act,label,o={}){
  const a=armed===act;
  return `<button data-act="${act}"${o.dis?' disabled':''} class="${a?'warn':(o.cls||'')}">${a?'確定？':label}</button>`;
}
function barHTML(s,name,st,btns){
  return `<div class="who"><span class="dot ${s}">${s==='r'?'帥':'將'}</span><div><div class="name">${name}</div><div class="state ${st.c||''}">${st.t}</div></div></div><div class="btns">${btns}</div>`;
}
function result(s){const why=over.mate?'將死':'困斃';return over.winner===s?{t:`獲勝 · ${why}`,c:'win'}:{t:`落敗 · 被${why}`,c:'lose'};}
function renderBars(chk){
  const T=$('barT'),M=$('barM');
  if(mode==='local'){
    const st=s=>over?result(s):turn===s?(chk?{t:'被將軍！',c:'check'}:{t:'輪到你'}):{t:'等待對手'};
    const common=btn('undo','悔棋',{dis:!hist.length})+(over?btn('again','再來一局',{cls:'go'}):btn('reset','重來'));
    T.className='bar rot'+(!over&&turn==='b'?' active':'')+(over&&over.winner==='b'?' won':'');
    M.className='bar'+(!over&&turn==='r'?' active':'')+(over&&over.winner==='r'?' won':'');
    T.innerHTML=barHTML('b','黑方',st('b'),common);
    M.innerHTML=barHTML('r','紅方',st('r'),common+btn('menu','選單'));
    return;
  }
  if(mode==='ai'){
    const o=opp(mySide);
    const ts=over?result(o):thinking?{t:'思考中…'}:(turn===o&&chk?{t:'被將軍！',c:'check'}:{t:'等待中'});
    T.className='bar'+(!over&&turn===o?' active':'')+(over&&over.winner===o?' won':'');
    T.innerHTML=barHTML(o,`AI · ${SIDE[o]}`,ts,`<span class="chip">Lv ${aiLevel}</span>`);
    const ms=over?result(mySide):turn===mySide?(chk?{t:'被將軍！',c:'check'}:{t:'輪到你'}):{t:'對手回合'};
    M.className='bar'+(!over&&turn===mySide?' active':'')+(over&&over.winner===mySide?' won':'');
    M.innerHTML=barHTML(mySide,`你 · ${SIDE[mySide]}`,ms,
      btn('undo','悔棋',{dis:!hist.some(h=>h.turn===mySide)})+(over?btn('again','再來一局',{cls:'go'}):btn('reset','重來'))+btn('menu','選單'));
    return;
  }
  const o=opp(mySide);
  const oppHere=role==='host'?!!(guestPeer&&guestOnline):hostOnline;
  let ts;
  if(role==='host'&&!guestPeer)ts={t:'等待對手加入…'};
  else if(!oppHere)ts={t:role==='host'?'對手已離線':'房主已離線',c:'check'};
  else if(over)ts=result(o);
  else ts=turn===o?(chk?{t:'被將軍！',c:'check'}:{t:'思考中…'}):{t:'等待中'};
  T.className='bar'+(!over&&turn===o&&oppHere?' active':'')+(over&&over.winner===o?' won':'');
  T.innerHTML=barHTML(o,`對手 · ${SIDE[o]}`,ts,`<span class="chip">房號 ${code}</span>`);
  let ms;
  if(note)ms={t:note};
  else if(over)ms=result(mySide);
  else if(pendingMove)ms={t:'傳送中…'};
  else if(turn===mySide)ms=chk?{t:'被將軍！',c:'check'}:{t:oppHere?'輪到你':'輪到你（等對手回來）'};
  else ms={t:'對手回合'};
  const hl=role==='host'?hist.length:guestHist;
  let b;
  if(undoAsk){ms={t:'對方要求悔棋',c:'check'};b=btn('agree','同意',{cls:'go'})+btn('deny','拒絕');}
  else b=btn('undoReq','悔棋',{dis:!(oppHere&&hl>0&&turn!==mySide&&!myUndoReq&&!pendingMove)})
        +(role==='host'&&over?btn('again','再來一局',{cls:'go'}):'')+btn('leave','離開');
  M.className='bar'+(!over&&turn===mySide?' active':'')+(over&&over.winner===mySide?' won':'');
  M.innerHTML=barHTML(mySide,`你 · ${SIDE[mySide]}`,ms,b);
}
function setNote(t){note=t;clearTimeout(noteTimer);noteTimer=setTimeout(()=>{note='';render();},2500);render();}

/* ---------- screens ---------- */
function menuMsg(t,err){const m=$('menuMsg');m.textContent=t;m.classList.toggle('err',!!err);}
function showMenu(msg,err){
  mode='menu';hideBanner();$('app').hidden=true;$('menu').hidden=false;
  setOnlineButtons();if(msg!==undefined)menuMsg(msg,err);
}
function enterGame(m){
  mode=m;sel=null;targets=[];armed=null;
  $('menu').hidden=true;$('app').hidden=false;
  drawGrid();requestAnimationFrame(()=>{fit();render();});render();
}
let busy=false;
function setOnlineButtons(){const ok=!!R&&!busy;$('createBtn').disabled=!ok;$('joinBtn').disabled=!ok;}

/* ---------- online (PeerJS · 房主當伺服器) ---------- */
const enc=b=>b.flat().map(p=>p?(p.s==='r'?p.t:p.t.toLowerCase()):'.').join('');
function dec(s){const b=[];for(let r=0;r<10;r++){b.push([]);for(let c=0;c<9;c++){const ch=s[r*9+c];
  b[r].push(ch==='.'?null:{t:ch.toUpperCase(),s:ch===ch.toUpperCase()?'r':'b'});}}return b;}
function snapshot(){return{seq,b:enc(board),t:turn,l:last?[...last.from,...last.to]:null,
  o:over?[over.winner,over.mate?1:0]:null,g:guestPeer,h:hist.length};}
const PREFIX='thortsui-xiangqi-';
let peer=null,conn=null;
function send(c,topic,data){try{if(c&&c.open)c.send({topic,data});}catch(e){}}
const ROOM={emit:(t,d)=>{send(conn,t,d);return Promise.resolve();},leave:()=>Promise.resolve()};
function broadcast(){if(role==='host')send(conn,'st',snapshot());}
const isOpp=()=>true;

function onState(m){
  if(role!=='guest')return;
  const d=m.data;
  if(!d||typeof d.b!=='string'||d.b.length!==90||!/^[RNBAKCPrnbakcp.]+$/.test(d.b)||!Number.isInteger(d.seq))return;
  if(mode==='online'&&d.seq<seq)return;
  const moved=mode==='online'&&d.seq>seq&&(d.h|0)>guestHist;
  seq=d.seq;board=dec(d.b);turn=d.t==='b'?'b':'r';
  const l=Array.isArray(d.l)&&d.l.length===4&&d.l.every(n=>Number.isInteger(n))?d.l:null;
  last=l?{from:[l[0],l[1]],to:[l[2],l[3]]}:null;
  over=Array.isArray(d.o)?{winner:d.o[0]==='b'?'b':'r',mate:!!d.o[1]}:null;
  if((d.h|0)<guestHist||(d.h|0)===0)hideBanner();
  if(moved){undoAsk=false;myUndoReq=false;}
  guestHist=d.h|0;pendingMove=false;clearTimeout(pendTimer);hostOnline=true;
  if(sel&&!(board[sel[0]][sel[1]]&&board[sel[0]][sel[1]].s===mySide)){sel=null;targets=[];}
  else if(sel)targets=legal(board,sel[0],sel[1]);
  if(mode!=='online'){busy=false;enterGame('online');}
  render();if(moved)announce();
}
function onHi(){if(role==='host')broadcast();}
function onMv(m){
  if(role!=='host'||over||turn!=='b')return;
  const d=m.data||{},{fr,fc,tr,tc}=d;
  if(![fr,fc,tr,tc].every(Number.isInteger)||!inB(fr,fc)||!inB(tr,tc)){broadcast();return;}
  const p=board[fr][fc];
  if(!p||p.s!=='b'||d.seq!==seq||!legal(board,fr,fc).some(([r,c])=>r===tr&&c===tc)){broadcast();return;}
  applyMove(fr,fc,tr,tc);
}
function onUr(){undoAsk=true;render();}
function onUa(m){
  if(!myUndoReq)return;
  myUndoReq=false;const ok=!!(m.data&&m.data.ok);
  if(ok&&role==='host')doUndo();
  setNote(ok?'對方同意悔棋':'對方拒絕悔棋');
}
function onFull(){if(role==='guest')failRoom('這個房間已經有兩位玩家了');}
const HANDLERS={st:onState,hi:onHi,mv:onMv,ur:onUr,ua:onUa,full:onFull};
function wire(c){
  c.on('data',d=>{if(c!==conn||!d||typeof d!=='object')return;const h=HANDLERS[d.topic];if(h)h({peer:c.peer,data:d.data});});
  c.on('close',()=>{if(c!==conn)return;if(role==='host')guestOnline=false;else hostOnline=false;pendingMove=false;render();});
  c.on('error',()=>{});
}
function hostAccept(c){
  if(conn&&conn.open&&conn.peer!==c.peer){
    c.on('open',()=>{send(c,'full',{});setTimeout(()=>{try{c.close()}catch(e){}},800);});return;}
  if(conn&&conn!==c){try{conn.close()}catch(e){}}
  conn=c;guestPeer=c.peer;wire(c);
  c.on('open',()=>{if(c!==conn)return;guestOnline=true;broadcast();render();});
}
function openPeer(id){
  return new Promise(res=>{
    let p,done=false;const fin=v=>{if(done)return;done=true;clearTimeout(t);res(v);};
    try{p=id?new Peer(id):new Peer();}catch(e){res({ok:false,err:'lib'});return;}
    const t=setTimeout(()=>{try{p.destroy()}catch(e){}fin({ok:false,err:'timeout'});},12000);
    p.on('open',()=>fin({ok:true,peer:p}));
    p.on('error',e=>{if(done)return;try{p.destroy()}catch(x){}fin({ok:false,err:e&&e.type});});
  });
}
function resetOnline(r,c){
  role=r;code=c;mySide=r==='host'?'r':'b';room=ROOM;
  hostPeer=null;guestPeer=null;myPeer=null;guestOnline=false;hostOnline=r==='host';seq=0;guestHist=0;
  pendingMove=false;undoAsk=false;myUndoReq=false;note='';
}
function leaveRoom(){
  clearInterval(rebroadcast);clearTimeout(pendTimer);
  try{conn&&conn.close()}catch(e){}try{peer&&peer.destroy()}catch(e){}
  conn=null;peer=null;room=null;role=null;
}
function failRoom(msg){leaveRoom();busy=false;showMenu(msg,true);}

async function createRoom(){
  busy=true;setOnlineButtons();menuMsg('建立房間中…');
  for(let i=0;i<5;i++){
    const c=String(Math.floor(Math.random()*10000)).padStart(4,'0');
    const r=await openPeer(PREFIX+c);
    if(r.ok){
      peer=r.peer;resetOnline('host',c);
      peer.on('connection',hostAccept);
      peer.on('disconnected',()=>{try{if(peer&&!peer.destroyed)peer.reconnect()}catch(e){}});
      peer.on('error',()=>{});
      init();busy=false;enterGame('online');
      rebroadcast=setInterval(()=>{if(guestOnline)broadcast();},4000);
      return;
    }
    if(r.err!=='unavailable-id'){busy=false;setOnlineButtons();menuMsg('連不上配對伺服器，請檢查網路後再試',true);return;}
  }
  busy=false;setOnlineButtons();menuMsg('房號剛好都被占用，請再試一次',true);
}
async function joinRoom(c){
  if(!/^\d{4}$/.test(c)){menuMsg('請輸入 4 位數字房號',true);return;}
  busy=true;setOnlineButtons();menuMsg(`尋找房間 ${c}…`);
  const r=await openPeer(null);
  if(!r.ok){busy=false;setOnlineButtons();menuMsg('連不上配對伺服器，請檢查網路後再試',true);return;}
  peer=r.peer;resetOnline('guest',c);hostPeer=PREFIX+c;
  const me=peer;
  peer.on('error',e=>{if(peer!==me)return;
    if(e&&e.type==='peer-unavailable'&&mode!=='online')failRoom(`找不到房號 ${c} 的房間`);});
  peer.on('disconnected',()=>{try{if(peer===me&&!me.destroyed)me.reconnect()}catch(e){}});
  const cn=peer.connect(hostPeer,{reliable:true});conn=cn;wire(cn);
  cn.on('open',()=>{if(conn!==cn)return;hostOnline=true;menuMsg('已找到房間，連線中…');send(cn,'hi',{});});
  for(let i=0;i<8&&mode!=='online'&&peer===me;i++){await sleep(1500);if(cn.open&&mode!=='online')send(cn,'hi',{});}
  if(mode!=='online'&&peer===me)failRoom('房主沒有回應，請確認房號');
}


/* ---------- input ---------- */
const CONFIRM=new Set(['reset','menu','leave']);
document.addEventListener('click',e=>{
  const b=e.target.closest('[data-act]');if(!b||b.disabled)return;
  const act=b.dataset.act;
  if(CONFIRM.has(act)&&armed!==act){armed=act;clearTimeout(armTimer);armTimer=setTimeout(()=>{armed=null;render();},2500);render();return;}
  armed=null;clearTimeout(armTimer);
  switch(act){
    case 'local':init();enterGame('local');break;
    case 'create':if(R&&!busy)createRoom();break;
    case 'join':if(R&&!busy)joinRoom($('codeIn').value.trim());break;
    case 'undo':mode==='ai'?aiUndo():doUndo();break;
    case 'sd':aiPick=b.dataset.v;document.querySelectorAll('#sdSeg button').forEach(x=>x.classList.toggle('on',x.dataset.v===aiPick));break;
    case 'aiStart':mySide=aiPick;init();enterGame('ai');maybeAI();break;
    case 'reset':case 'again':newGame();break;
    case 'menu':aiCancel();showMenu('');break;
    case 'leave':leaveRoom();showMenu('');break;
    case 'undoReq':if(room){room.emit('ur',{seq}).catch(()=>{});myUndoReq=true;setNote('已請求悔棋，等待對方回應…');}break;
    case 'agree':undoAsk=false;if(role==='host')doUndo();room&&room.emit('ua',{ok:true}).catch(()=>{});render();break;
    case 'deny':undoAsk=false;room&&room.emit('ua',{ok:false}).catch(()=>{});render();break;
  }
});
$('layer').addEventListener('click',e=>{
  const b=e.target.closest('[data-r]');
  if(b)tap(+b.dataset.r,+b.dataset.c);else if(sel){sel=null;targets=[];render();}
});
$('lvIn').addEventListener('input',e=>{aiLevel=+e.target.value;syncLv();});
syncLv();
$('codeIn').addEventListener('input',e=>{e.target.value=e.target.value.replace(/\D/g,'').slice(0,4);});
$('codeIn').addEventListener('keydown',e=>{if(e.key==='Enter'&&R&&!busy)joinRoom(e.target.value.trim());});

function fit(){if(mode==='menu')return;const st=$('stage'),W=st.clientWidth,H=st.clientHeight;
  $('board').style.width=Math.max(200,Math.min(W,H*0.9))+'px';}
addEventListener('resize',fit);

R=typeof Peer!=='undefined';
setOnlineButtons();
menuMsg(R?'':'連線元件載入失敗，請檢查網路；仍可玩單機或 AI 對戰',!R);

function start(saved){
  init();
  if(saved&&saved.mode==='local'&&saved.board){({board,turn,hist,last,over}=saved);enterGame('local');}
  else showMenu();
}
start({});
</script>
