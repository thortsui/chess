(module
  (memory (export "mem") 1)
  (func (export "matvec") (param $W i32) (param $x i32) (param $y i32) (param $R i32) (param $C i32)
    (local $r i32) (local $j i32) (local $n i32) (local $xp i32)
    (local $a v128) (local $b v128) (local $c v128) (local $d v128)
    (local.set $n (i32.shl (local.get $C) (i32.const 2)))
    (block $done (loop $rows
      (br_if $done (i32.ge_u (local.get $r) (local.get $R)))
      (local.set $a (f32x4.splat (f32.const 0))) (local.set $b (local.get $a)) (local.set $c (local.get $a)) (local.set $d (local.get $a))
      (local.set $j (i32.const 0))
      (loop $cols
        (local.set $xp (i32.add (local.get $x) (local.get $j)))
        (local.set $a (f32x4.add (local.get $a) (f32x4.mul (v128.load (local.get $W)) (v128.load (local.get $xp)))))
        (local.set $b (f32x4.add (local.get $b) (f32x4.mul (v128.load offset=16 (local.get $W)) (v128.load offset=16 (local.get $xp)))))
        (local.set $c (f32x4.add (local.get $c) (f32x4.mul (v128.load offset=32 (local.get $W)) (v128.load offset=32 (local.get $xp)))))
        (local.set $d (f32x4.add (local.get $d) (f32x4.mul (v128.load offset=48 (local.get $W)) (v128.load offset=48 (local.get $xp)))))
        (local.set $W (i32.add (local.get $W) (i32.const 64)))
        (local.set $j (i32.add (local.get $j) (i32.const 64)))
        (br_if $cols (i32.lt_u (local.get $j) (local.get $n))))
      (local.set $a (f32x4.add (f32x4.add (local.get $a) (local.get $b)) (f32x4.add (local.get $c) (local.get $d))))
      (f32.store (local.get $y) (f32.add (f32.add (f32x4.extract_lane 0 (local.get $a)) (f32x4.extract_lane 1 (local.get $a))) (f32.add (f32x4.extract_lane 2 (local.get $a)) (f32x4.extract_lane 3 (local.get $a)))))
      (local.set $y (i32.add (local.get $y) (i32.const 4)))
      (local.set $r (i32.add (local.get $r) (i32.const 1)))
      (br $rows))))
  (func (export "wsum") (param $V i32) (param $a i32) (param $y i32) (param $T i32) (param $C i32)
    (local $t i32) (local $j i32) (local $n i32) (local $yp i32) (local $s v128)
    (local.set $n (i32.shl (local.get $C) (i32.const 2)))
    (local.set $j (i32.const 0))
    (loop $zero
      (v128.store (i32.add (local.get $y) (local.get $j)) (f32x4.splat (f32.const 0)))
      (local.set $j (i32.add (local.get $j) (i32.const 16)))
      (br_if $zero (i32.lt_u (local.get $j) (local.get $n))))
    (block $done (loop $rows
      (br_if $done (i32.ge_u (local.get $t) (local.get $T)))
      (local.set $s (f32x4.splat (f32.load (local.get $a))))
      (local.set $j (i32.const 0))
      (loop $cols
        (local.set $yp (i32.add (local.get $y) (local.get $j)))
        (v128.store (local.get $yp) (f32x4.add (v128.load (local.get $yp)) (f32x4.mul (local.get $s) (v128.load (local.get $V)))))
        (v128.store offset=16 (local.get $yp) (f32x4.add (v128.load offset=16 (local.get $yp)) (f32x4.mul (local.get $s) (v128.load offset=16 (local.get $V)))))
        (v128.store offset=32 (local.get $yp) (f32x4.add (v128.load offset=32 (local.get $yp)) (f32x4.mul (local.get $s) (v128.load offset=32 (local.get $V)))))
        (v128.store offset=48 (local.get $yp) (f32x4.add (v128.load offset=48 (local.get $yp)) (f32x4.mul (local.get $s) (v128.load offset=48 (local.get $V)))))
        (local.set $V (i32.add (local.get $V) (i32.const 64)))
        (local.set $j (i32.add (local.get $j) (i32.const 64)))
        (br_if $cols (i32.lt_u (local.get $j) (local.get $n))))
      (local.set $a (i32.add (local.get $a) (i32.const 4)))
      (local.set $t (i32.add (local.get $t) (i32.const 1)))
      (br $rows))))
)
